# Copy to .env.local for your own machine. Never commit real values.
# The published app reads these from Cursor secrets, not from a file on the build machine.
# Leave a value empty to keep the safe fallback described below.

# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Example: https://your-domain.example
# When empty, the site uses the host of the current request.
SITE_URL=

# Password for /admin. Minimum 8 characters. When empty, Studio shows a locked screen
# and inquiries can still be saved, but nobody can open them.
ADMIN_PASSWORD=

# Resend (https://resend.com). All three must be set or the form saves the inquiry
# and tells the visitor that email notification is not connected.
# RESEND_FROM_EMAIL must be a sender Resend has verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=

# Analytics and Search Console. Omit to leave the tags out of the page.
# If GTM_CONTAINER_ID is set, the direct GA4 tag is not also loaded.
# These are measurement IDs, not secret API keys.
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=

# DATABASE_URL is set by Cursor when the app is published. Do not invent one
# and do not commit one. Local runs use in-memory PGlite when it is unset.
